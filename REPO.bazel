# Directories that hold no source of this repository: VCS metadata, Bazel's
# convenience links, the Python environment, tool caches, agent worktrees,
# scratch work, staged consumer files and Obsidian's vault settings.
# Ignoring them keeps them out of every package and every glob, so the
# whole-tree checks (//:repo_files) never scan them.
ignore_directories([
    ".git",
    ".bazel-*",
    "bazel-*",
    ".bazel_env",
    ".mise",
    ".venv",
    "tmp",
    ".worktrees",
    ".claude/worktrees",
    "consumers",
    "**/__pycache__",
    "**/.*_cache",
    ".vale/Google",
    ".vale/write-good",
    ".vale/proselint",
    ".vale/ai-tells*",
    # Obsidian vault settings, from opening the repository as a vault.
    ".obsidian",
])
