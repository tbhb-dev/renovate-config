{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Only tbhb-dev/rules extends this preset, after bazel.json5. That is a
  // convention. The command allowlist is global, not per repo.
  packageRules: [
    // A wrangler bump that moves workerd changes every Worker's generated
    // types, and worker_types_test fails until they are regenerated. The two
    // smoke Workers (the root one and the nested one) sit in one Bazel
    // workspace, cloudflare/e2e/smoke. The commands are allowlisted by
    // anchored regexes in the workflow env (RENOVATE_ALLOWED_COMMANDS), not
    // here. fileFilters limits the commit to worker-configuration.d.ts.
    // automerge is off: no one has confirmed that the reviews App's path
    // limit accepts cloudflare/e2e/smoke/**/worker-configuration.d.ts, so a
    // human merges these PRs. Delete the line once the App is confirmed to
    // approve that diff, as it does for cloudflare-worker.json5.
    // The rule has no file match: a grouped branch takes its tasks from the
    // first-sorted member, which may live outside cloudflare/ (storybook/,
    // playwright/), so every listed package carries them. A live run on the
    // first such bump is the check.
    {
      description: "bumps in the wrangler group regenerate the smoke Workers' types in-branch",
      automerge: false,
      matchPackageNames: [
        "vitest",
        "@vitest/**",
        "@cloudflare/vitest-plugin",
        "wrangler",
        "playwright",
        "playwright-core",
      ],
      postUpgradeTasks: {
        commands: [
          "bazelisk run //:worker_types_test.update",
          "bazelisk run //nested:worker_types_test.update",
        ],
        workingDirTemplate: "cloudflare/e2e/smoke",
        fileFilters: ["cloudflare/e2e/smoke/**/worker-configuration.d.ts"],
        executionMode: "branch",
        installTools: { bazelisk: {} },
      },
    },
  ],
}
