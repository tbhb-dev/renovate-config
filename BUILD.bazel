load("@bazel_env.bzl", "bazel_env")
load("@bazelrc-preset.bzl", "bazelrc_preset")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@tbhb_rules//format:defs.bzl", "format", "format_test")
load(
    "@tbhb_rules//lint:defs.bzl",
    "actionlint_test",
    "codeowners_test",
    "cspell_test",
    "editorconfig_checker_test",
    "gitleaks_history",
    "gitleaks_test",
    "reuse_test",
    "rumdl_test",
    "ryl_test",
    "shellcheck_test",
    "shfmt_test",
    "tombi_test",
    "vale_sync",
    "vale_test",
    "zizmor_test",
)
load("@tbhb_rules//repo:defs.bzl", "repo_files", "repo_layout_test")

# Every file of the repository, for the whole-tree checks below. Ignored
# directories are listed in REPO.bazel; these are the gitignored files that
# can sit at the root of a working checkout.
repo_files(
    exclude = [
        ".DS_Store",
        "**/.DS_Store",
        ".bazelrc.user",
        ".env*",
        ".github/PULL_REQUEST_DRAFT.md",
        "mise.local.toml",
    ],
)

# Generates preset.bazelrc, which .bazelrc imports. The content depends on the
# Bazel version that runs the generator; the committed copy matches
# .bazelversion, and `preset.update_test` fails when it is stale.
bazelrc_preset(
    name = "preset",
)

# buildifier: `//:buildifier` formats and applies lint fixes in place,
# `//:buildifier.check` fails on any formatting or lint difference, and the
# test below makes `bazel test //...` fail on the same findings. Every
# available warning is on. Bazel's convenience symlinks, agent worktrees,
# and the Python and tool caches hold no Starlark that this repository owns.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.venv/*",
    "./.mise/*",
    "./.bazel-*",
    "./bazel-*",
    "./.worktrees/*",
    "./tmp/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    lint_warnings = ["all"],
    mode = "fix",
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    lint_warnings = ["all"],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

# The repository's shape. Only these top-level directories may exist; add a
# new one here in the change that first uses it.
repo_layout_test(
    name = "repo_layout_test",
    srcs = [":repo_files"],
    top_level_dirs = [
        ".agents",
        ".claude",
        ".codex",
        ".github",
        ".vale",
        "LICENSES",
    ],
)

# Scans the git history: `bazel run //:gitleaks_history`, which CI runs.
# The working tree is //:gitleaks_test's job.
gitleaks_history(
    name = "gitleaks_history",
    config = ".gitleaks.toml",
)

# This repository's gates, from @tbhb_rules. Each one checks the whole tree.
gitleaks_test(
    name = "gitleaks_test",
    srcs = [":repo_files"],
    config = ".gitleaks.toml",
)

# Copyright and licensing information on every file (REUSE.toml, LICENSES/).
reuse_test(
    name = "reuse_test",
    srcs = [":repo_files"],
)

ryl_test(
    name = "ryl_test",
    srcs = [":repo_files"],
    config = ".ryl.toml",
)

tombi_test(
    name = "tombi_test",
    srcs = [":repo_files"],
    config = "tombi.toml",
)

rumdl_test(
    name = "rumdl_test",
    srcs = [":repo_files"],
    config = ".rumdl.toml",
)

editorconfig_checker_test(
    name = "editorconfig_checker_test",
    srcs = [":repo_files"],
    config = ".editorconfig-checker.json",
)

actionlint_test(
    name = "actionlint_test",
    srcs = [":repo_files"],
)

zizmor_test(
    name = "zizmor_test",
    srcs = [":repo_files"],
    config = ".github/zizmor.yml",
)

# Shell scripts are selected by extension and by shebang. shfmt reads its
# style from .editorconfig. The repository has no shell scripts today, so
# allow_empty keeps both checks wired for a script added later.
shellcheck_test(
    name = "shellcheck_test",
    srcs = [":repo_files"],
    allow_empty = True,
)

shfmt_test(
    name = "shfmt_test",
    srcs = [":repo_files"],
    allow_empty = True,
)

codeowners_test(
    name = "codeowners_test",
    srcs = [":repo_files"],
)

cspell_test(
    name = "cspell_test",
    srcs = [":repo_files"],
    config = ".cspell.jsonc",
    data = [".cspell-words.txt"],
)

# The packages .vale.ini lists, pinned in MODULE.bazel, in the config's
# order. `bazel run //:vale_sync` writes them into .vale/ for editors.
VALE_PACKAGES = {
    "Google": "@vale_google//file",
    "ai-tells": "@vale_ai_tells//file",
    "ai-tells-experimental": "@vale_ai_tells_experimental//file",
    "proselint": "@vale_proselint//file",
    "write-good": "@vale_write_good//file",
}

vale_test(
    name = "vale_test",
    srcs = [":repo_files"],
    config = ".vale.ini",
    packages = VALE_PACKAGES,
)

vale_sync(
    name = "vale_sync",
    config = ".vale.ini",
    packages = VALE_PACKAGES,
)

# Formatting: `bazel run //:format` rewrites, `bazel run //:format.check`
# checks the working tree, and format_test is the cached check in `bazel
# test //...`.
FORMATTERS = [
    "@tbhb_rules//format:buildifier",
    "@tbhb_rules//format:rumdl",
    "@tbhb_rules//format:ryl",
    "@tbhb_rules//format:shfmt",
    "@tbhb_rules//format:tombi",
]

# Consumers pin the two reusable workflows by commit, and any change to them
# at main bumps every consumer's pin, so no formatter rewrites them; they
# change only in a deliberate PR.
FORMAT_EXCLUDE = [
    ".github/workflows/renovate.yaml",
    ".github/workflows/renovate-config-validator.yaml",
]

format(
    name = "format",
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)

format_test(
    name = "format_test",
    srcs = [":repo_files"],
    exclude = FORMAT_EXCLUDE,
    formatters = FORMATTERS,
)

# `bazel run //:bazel_env` puts shims for the Bazel-pinned tools in
# .bazel_env/bin, which mise adds to PATH. Git hooks call them directly, so
# a commit never waits on the Bazel server.
bazel_env(
    name = "bazel_env",
    tools = {
        "actionlint": "@tbhb_rules_actionlint//:actionlint",
        "buildifier": "@buildifier_prebuilt//:buildifier",
        "cog": "@tbhb_rules_cog//:cog",
        "editorconfig-checker": "@tbhb_rules_editorconfig_checker//:editorconfig-checker",
        "git": "@tbhb_rules_git//:git",
        "gitleaks": "@tbhb_rules_gitleaks//:gitleaks",
        "rumdl": "@tbhb_rules_rumdl//:rumdl",
        "ryl": "@tbhb_rules_ryl//:ryl",
        "shellcheck": "@tbhb_rules_shellcheck//:shellcheck",
        "shfmt": "@tbhb_rules_shfmt//:shfmt",
        "tombi": "@tbhb_rules_tombi//:tombi",
        "vale": "@tbhb_rules_vale//:vale",
        "zizmor": "@tbhb_rules_zizmor//:zizmor",
    },
)

# Exercise the inline workflow script with local logs, without Renovate.
sh_test(
    name = "renovate_log_check_test",
    size = "small",
    srcs = ["renovate_log_check_test.sh"],
    data = [
        ".github/workflows/renovate.yaml",
        "renovate_log_check_test.py",
    ],
)

# Exercise the inline range check against Git history and a fake GitHub API.
sh_test(
    name = "renovate_pin_range_test",
    size = "small",
    srcs = ["renovate_pin_range_test.sh"],
    data = [
        ".github/workflows/renovate-config-validator.yaml",
        "renovate_pin_range_test.py",
    ],
)
